<%= tag.div(**root_attrs(class: root_classes, role: role, data: { tone: tone, **root_data })) do %>
  <span class="ss-notice-ico" aria-hidden="true"><%= icon %></span>
  <div class="ss-notice-main">
    <div class="ss-notice-head">
      <% if unread? %><span class="ss-notice-dot" aria-hidden="true"></span><% end %>
      <b class="ss-notice-title"><% if link? %><%= link_to title, url, class: "ss-notice-link" %><% else %><%= title %><% end %><% if unread? %><span class="ss-sr"> (<%= ss_t("notice_card.unread", default: "não lido") %>)</span><% end %></b>
      <% if time %><time class="ss-notice-time num"><%= time %></time><% end %>
    </div>
    <% if text %><p class="ss-notice-text"><%= text %></p><% end %>
    <% if image_url %><img class="ss-notice-img" src="<%= image_url %>" alt="<%= image_alt.to_s %>" loading="lazy" decoding="async"><% end %>
    <% if actions.any? %>
      <div class="ss-notice-actions"><% actions.each_with_index do |a, i| %><%= action_button(a, i) %><% end %></div>
    <% end %>
    <% if footer_any? %><div class="ss-notice-foot"><%= footer? ? footer : footer_text %></div><% end %>
  </div>
  <% if dismiss? %><%= close_button %><% end %>
<% end %>
