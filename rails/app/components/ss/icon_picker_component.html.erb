<%= tag.div(**root_attrs(class: classes("ss-iconpick"), data: root_data)) do %>
  <input type="hidden" name="<%= name %>" value="<%= value %>" data-ss-icon-picker-target="input">
  <label class="ss-iconpick-search">
    <%= Ss::CasaIcons.svg(:search) %>
    <input type="search" class="ss-input" placeholder="<%= label(:search) %>" aria-label="<%= label(:search) %>" aria-controls="<%= id %>"
           autocomplete="off" data-ss-icon-picker-target="query" data-action="input->ss-icon-picker#filter">
  </label>
  <div id="<%= id %>" class="ss-iconpick-grid" role="radiogroup" aria-label="<%= label(:label) %>"
       data-action="keydown->ss-icon-picker#keydown">
    <% if allow_none? %>
      <button type="button" role="radio" class="ss-iconpick-cell is-none" aria-checked="<%= none_selected? %>" tabindex="<%= none_selected? ? 0 : -1 %>"
              title="<%= label(:none) %>" aria-label="<%= label(:none) %>" data-name="" data-search="" data-action="ss-icon-picker#pick"><%= Ss::CasaIcons.svg(:block) %></button>
    <% end %>
    <% icons.each_with_index do |(n, svg, lbl), i| %>
      <button type="button" role="radio" class="ss-iconpick-cell" aria-checked="<%= selected?(n) %>"
              tabindex="<%= selected?(n) || (i.zero? && !allow_none? && icons.none? { |(x, _)| selected?(x) }) ? 0 : -1 %>"
              title="<%= lbl %>" aria-label="<%= lbl %>" data-name="<%= n %>" data-search="<%= search_key(n, lbl) %>" data-action="ss-icon-picker#pick"><%= svg.html_safe %></button>
    <% end %>
  </div>
  <p class="ss-iconpick-empty" hidden data-ss-icon-picker-target="empty" data-template="<%= label(:empty) %>"></p>
<% end %>
