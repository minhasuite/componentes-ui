<%= tag.fieldset(class: classes("ss-otp"), **root_attrs(data: { controller: "ss-otp" })) do %>
  <legend class="ss-label"><%= label %></legend>
  <div class="ss-otp-boxes">
    <% length.times do |i| %>
      <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="num" placeholder="·" aria-label="Dígito <%= i + 1 %> de <%= length %>"
             <% if i.zero? %>autocomplete="one-time-code"<% else %>autocomplete="off"<% end %>
             data-ss-otp-target="box" data-action="input->ss-otp#type keydown->ss-otp#key paste->ss-otp#paste focus->ss-otp#select">
    <% end %>
  </div>
  <input type="hidden" name="<%= name %>" data-ss-otp-target="hidden">
<% end %>
