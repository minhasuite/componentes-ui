<%= tag.div(**root_attrs(class: classes("ss-settings", ("is-pages" if pages?)), data: (pages? ? {} : { controller: "ss-scrollspy" }))) do %>
  <nav class="ss-settings-nav" aria-label="<%= @nav_label %>" data-controller="ss-indicator" data-ss-indicator-selector-value="a">
    <% if @title %><p class="ss-settings-title"><%= @title %></p><% end %>
    <% sections.each_with_index do |s, i| %>
      <%= tag.a(href: nav_href(s), "aria-current": (nav_current?(s, i) ? (pages? ? "page" : "true") : nil)) do %><%= icon(s.icon) %><span><%= s.title %></span><% end %>
    <% end %>
  </nav>
  <div class="ss-settings-main">
    <% shown_sections.each do |s| %><%= s %><% end %>
    <%= content %>
  </div>
<% end %>
