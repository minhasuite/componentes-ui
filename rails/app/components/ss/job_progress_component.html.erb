<%= tag.div(**root_attrs(id: id, class: classes("ss-card", "ss-job"), data: in_view_data(state: state), "aria-live": "polite", "aria-busy": (%i[queued running].include?(state) ? "true" : "false"))) do %>
  <div class="ss-job-head">
    <b><%= title %></b>
    <span class="ss-status" data-tone="<%= tone %>"><%= state_label %><% if state == :running && determinate? %> · <span class="num"><%= pct %>%</span><% end %></span>
  </div>
  <% if state != :failed && bar? %>
    <div class="ss-job-bar<%= " is-indet" unless determinate? %>" role="progressbar" aria-label="<%= title %>" aria-valuemin="0" aria-valuemax="100"<% if determinate? %> aria-valuenow="<%= pct %>"<% end %>>
      <i style="width:<%= determinate? ? pct : 100 %>%"></i>
    </div>
  <% end %>
  <% if steps.any? %>
    <ol class="ss-job-steps">
      <% steps.each_with_index do |s, i| %><li class="<%= step_state(i) %>"><%= s %></li><% end %>
    </ol>
  <% end %>
  <% if stages? %>
    <ol class="ss-job-stages">
      <% stages.each do |st| %>
        <li class="is-<%= stage_status(st) %>">
          <span class="ss-job-stage-ico" title="<%= stage_label(st) %>"><%= stage_icon(st) %><span class="ss-sr"><%= stage_label(st) %></span></span>
          <span class="ss-job-stage-name"><%= st[:name] %><% if st[:detail].present? %><small><%= st[:detail] %></small><% end %></span>
          <% if st[:duration] %><span class="ss-job-stage-time num"><%= duration_text(st[:duration]) %></span><% end %>
        </li>
      <% end %>
      <% if (tt = total_text) %><li class="ss-job-stage-total"><span class="ss-job-stage-name"><%= ss_t("job_progress.total", default: "Total") %></span><span class="ss-job-stage-time num"><%= tt %></span></li><% end %>
    </ol>
  <% end %>
  <% if detail && state != :failed %><p class="ss-job-detail"><%= detail %></p><% end %>
  <% if state == :done && result_url %><a class="ss-btn ss-btn-outline ss-btn-sm" href="<%= result_url %>"><%= result_label %></a><% end %>
  <% if state == :failed %>
    <p class="ss-job-error"><%= error || ss_t("job_progress.error", default: "Algo deu errado.") %></p>
    <% if retry_url %><%= button_to ss_t("common.retry", default: "Tentar de novo"), retry_url, method: :post, class: "ss-btn ss-btn-outline ss-btn-sm" %><% end %>
  <% end %>
<% end %>
