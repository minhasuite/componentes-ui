<%= tag.section(**root_attrs(class: classes("ss-agenda", ("is-week" if week?)), "aria-label": label, style: "--hours:#{hours.size};--days:#{days.size};--hour-h:#{hour_height}px")) do %>
  <% if week? %>
    <div class="ss-agenda-head" aria-hidden="true">
      <span></span>
      <% days.each do |d| %><span class="<%= "is-today" if today?(d) %>"><small><%= weekdays[d.wday] %></small><b class="num"><%= d.day %></b></span><% end %>
    </div>
  <% end %>
  <% if all_day? %>
    <div class="ss-agenda-allday">
      <span class="ss-agenda-allday-label"><%= all_day_label %></span>
      <% days.each do |d| %>
        <ul class="ss-agenda-allday-col" aria-label="<%= day_label(d) %>: <%= all_day_label %>">
          <% all_day_on(d).each do |e| %>
            <li class="ss-agenda-event is-all-day" data-tone="<%= e[:tone] || "accent" %>">
              <%= e[:url] ? link_to(e[:url], class: "ss-agenda-in") { safe_join([tag.b(e[:title]), (tag.small(e[:sub]) if e[:sub])].compact) } :
                            tag.div(class: "ss-agenda-in") { safe_join([tag.b(e[:title]), (tag.small(e[:sub]) if e[:sub])].compact) } %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
  <div class="ss-agenda-body">
    <ol class="ss-agenda-hours" aria-hidden="true">
      <% hours.each do |h| %><li class="num"><%= format("%02d:00", h) %></li><% end %>
    </ol>
    <div class="ss-agenda-grid">
      <div class="ss-agenda-lines" aria-hidden="true"><% hours.each do %><i></i><% end %></div>
      <% days.each do |d| %>
        <div class="ss-agenda-col" role="group" aria-label="<%= day_label(d) %>">
          <ul>
            <% layout(events_on(d)).each do |p| %>
              <% e = p[:event] %>
              <li class="ss-agenda-event" data-tone="<%= e[:tone] || "accent" %>" style="top:<%= p[:top] %>%;height:<%= p[:height] %>%;left:<%= p[:left] %>%;width:<%= p[:width] %>%">
                <%= e[:url] ? link_to(e[:url], class: "ss-agenda-in") { safe_join([tag.b(e[:title]), tag.small(safe_join([tag.span("#{hhmm(e[:starts_at])}–#{hhmm(e[:ends_at])}", class: "num"), (" · #{e[:sub]}" if e[:sub])].compact))]) } :
                              tag.div(class: "ss-agenda-in") { safe_join([tag.b(e[:title]), tag.small(safe_join([tag.span("#{hhmm(e[:starts_at])}–#{hhmm(e[:ends_at])}", class: "num"), (" · #{e[:sub]}" if e[:sub])].compact))]) } %>
              </li>
            <% end %>
          </ul>
          <% if (nt = now_top(d)) %><div class="ss-agenda-now" style="top:<%= nt %>%"><span class="ss-sr"><%= now_text %></span></div><% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
