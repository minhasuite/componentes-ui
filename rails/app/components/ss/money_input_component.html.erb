<%= tag.div(class: classes("ss-field", "ss-money-input", ("is-expression" if expression?), ("has-voice" if voice?)),
      **root_attrs(data: { controller: ["ss-money", ("ss-spoken-amount" if voice?)].compact.join(" "), ss_money_currency_value: currency, ss_money_signed_value: signed?,
                           ss_money_expression_value: expression?, ss_money_invalid_value: (invalid_text if expression?),
                           ss_spoken_amount_texts_value: (voice_texts.to_json if voice?), ss_spoken_amount_expression_value: (expression? if voice?) }.compact)) do %>
  <label for="<%= id %>"><%= label %></label>
  <div class="ss-money-box">
    <input id="<%= id %>" type="text" inputmode="<%= expression? ? "decimal" : "numeric" %>" autocomplete="off" class="ss-input ss-money" value="<%= formatted %>"
           placeholder="<%= placeholder %>"<% if required %> required<% end %><% if described_by %> aria-describedby="<%= described_by %>"<% end %>
           data-ss-money-target="input"<% if voice? %> data-ss-spoken-amount-target="input"<% end %> data-action="input->ss-money#format focus->ss-money#toEnd click->ss-money#toEnd keydown->ss-money#key<%= " blur->ss-money#settle" if expression? %>">
    <span class="ss-money-view num" aria-hidden="true" data-ss-money-target="view"><%= helpers.ss_amount(formatted) unless formatted.empty? || expression? %></span>
    <% if voice? %><button type="button" class="ss-icon-btn is-sm ss-money-mic" hidden aria-label="<%= voice_texts[:speak] %>" title="<%= voice_texts[:speak] %>" aria-pressed="false" data-ss-spoken-amount-target="button" data-action="ss-spoken-amount#listen"><%= helpers.ss_icon("microphone", size: nil) %></button><% end %>
  </div>
  <% if expression? %><small class="ss-money-result num" id="<%= id %>-result" aria-live="polite" data-ss-money-target="result"></small><% end %>
  <% if voice? %><small class="ss-spoken" aria-live="polite" hidden data-ss-spoken-amount-target="out"></small><% end %>
  <% if help %><small class="ss-field-help" id="<%= id %>-help"><%= help %></small><% end %>
  <input type="hidden" name="<%= name %>" value="<%= value_cents %>" data-ss-money-target="hidden">
<% end %>
