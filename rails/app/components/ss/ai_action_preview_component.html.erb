<%= form_with(url: apply_url, method: http_method, **root_attrs(class: classes("ss-ai-preview"), "aria-labelledby": "#{uid}-t",
      data: { controller: "ss-ai-preview", ss_ai_preview_template_value: t("preview_selected"), ss_ai_preview_total_value: changes.size })) do %>
  <header class="ss-ai-preview-head">
    <span class="ss-ai-badge" aria-hidden="true"><%= ss_icon("sparkles", size: :xs) %></span>
    <div>
      <h3 id="<%= uid %>-t"><%= title %></h3>
      <p><%= subtitle %></p>
    </div>
  </header>
  <% if changes.size > 1 %>
    <div class="ss-ai-preview-bar">
      <span class="ss-ai-preview-count" aria-live="polite" data-ss-ai-preview-target="count"><%= counter %></span>
      <span>
        <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="ss-ai-preview#all"><%= t("preview_select_all") %></button>
        <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="ss-ai-preview#none"><%= t("preview_select_none") %></button>
      </span>
    </div>
  <% end %>
  <ol class="ss-ai-preview-list">
    <% changes.each_with_index do |c, i| %>
      <li class="ss-ai-change">
        <label class="ss-ai-change-head">
          <input type="checkbox" name="<%= param %>[]" value="<%= c[:id] %>"<% if c[:selected] %> checked<% end %>
                 aria-label="<%= t("preview_include", title: c[:title]) %>" data-ss-ai-preview-target="box" data-action="ss-ai-preview#update">
          <span><b><%= c[:title] %></b><% if c[:subtitle] %><small><%= c[:subtitle] %></small><% end %></span>
        </label>
        <dl class="ss-ai-diff">
          <% c[:fields].each do |f| %>
            <div class="ss-ai-diff-row" data-kind="<%= f[:kind] %>">
              <dt><%= f[:label] %> <span class="ss-badge ss-badge-<%= { added: "success", removed: "danger", changed: "warn" }[f[:kind]] %>"><%= kind_label(f[:kind]) %></span></dt>
              <dd>
                <span class="ss-sr"><%= t("preview_before") %>:</span><del class="<%= "is-empty" if f[:before].blank? %>"><%= f[:before].presence || empty %></del>
                <span class="ss-ai-diff-arrow" aria-hidden="true">→</span>
                <span class="ss-sr"><%= t("preview_after") %>:</span><ins class="<%= "is-empty" if f[:after].blank? %>"><%= f[:after].presence || empty %></ins>
              </dd>
            </div>
          <% end %>
        </dl>
      </li>
    <% end %>
  </ol>
  <p class="ss-ai-preview-none" role="status" data-ss-ai-preview-target="none"<% unless selected_count.zero? %> hidden<% end %>><%= t("preview_none") %></p>
  <div class="ss-ai-preview-actions">
    <% if cancel_href %>
      <a class="ss-btn ss-btn-ghost" href="<%= cancel_href %>"><%= t("preview_cancel") %></a>
    <% else %>
      <button type="button" class="ss-btn ss-btn-ghost" data-ss-dialog-dismiss><%= t("preview_cancel") %></button>
    <% end %>
    <% if adjust_href %><a class="ss-btn ss-btn-outline" href="<%= adjust_href %>"><%= t("preview_adjust") %></a><% end %>
    <button type="submit" class="ss-btn ss-btn-primary" data-ss-ai-preview-target="apply"<% if selected_count.zero? %> disabled<% end %>><%= t("preview_apply") %></button>
  </div>
<% end %>
