<%= tag.div(**root_attrs(class: classes("ss-card", "ss-wx"), data: { condition: condition })) do %>
  <div class="ss-wx-now" role="group" aria-label="<%= [location, temperature, condition_text].compact.join(", ") %>">
    <div class="ss-wx-main">
      <% if location %><span class="ss-wx-loc"><%= location %></span><% end %>
      <b class="ss-wx-temp num"><%= temperature %></b>
      <span class="ss-wx-cond"><%= condition_text %></span>
      <% if min_max.present? %><span class="ss-wx-minmax num"><%= min_max %></span><% end %>
    </div>
    <%= icon(condition, size: 64) %>
  </div>
  <% if humidity || wind %>
    <ul class="ss-wx-pills">
      <% if humidity %><li><%= Ss::CasaIcons.svg(:drop) %><span><%= label(:humidity) %></span><b class="num"><%= humidity %>%</b></li><% end %>
      <% if wind %><li><%= Ss::CasaIcons.svg(:wind) %><span><%= label(:wind_label) %></span><b class="num"><%= wind.to_f.round %> <%= wind_unit %></b></li><% end %>
    </ul>
  <% end %>
  <% if forecast.any? %>
    <ol class="ss-wx-strip" aria-label="<%= label(:forecast) %>" tabindex="0">
      <% forecast.each_with_index do |f, i| %>
        <li style="--i: <%= i %>" aria-label="<%= forecast_aria(f) %>">
          <span class="ss-wx-when" aria-hidden="true"><%= f[:label] %></span>
          <%= icon(f[:condition], size: 26) %>
          <b class="num" aria-hidden="true"><%= t(f[:temp]) %></b>
          <% if f[:min] %><small class="num" aria-hidden="true"><%= t(f[:min]) %></small><% elsif f[:precip] %><small class="num is-rain" aria-hidden="true"><%= f[:precip] %>%</small><% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
<% end %>
