<%= tag.div(**root_attrs(class: classes("ss-sticky-bar"), role: "region", "aria-label": ss_t("sticky_action_bar.region", default: "Ações do formulário"), "data-visible": (@always ? "" : nil),
      data: { controller: "ss-dirty", ss_dirty_message_value: @confirm }.compact)) do %>
  <% if summary? %>
    <div class="ss-sticky-bar-summary" aria-live="polite"><%= summary %></div>
  <% else %>
    <span class="ss-sticky-bar-msg" aria-live="polite"><%= @message %></span>
  <% end %>
  <div class="ss-sticky-bar-actions">
    <% if content? %>
      <%= content %>
    <% else %>
      <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="ss-dirty#reset"><%= @cancel_label %></button>
      <button type="submit" class="ss-btn ss-btn-primary ss-btn-sm"><%= @save_label %></button>
    <% end %>
  </div>
<% end %>
