<%# v1.7: a peça de tela cheia sozinha (?tela=1), sem a moldura da vitrine. Tema, paleta e contraste pela URL. %>
<% tema = params[:tema].to_s %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" <%= tag.attributes(ss_density_attrs) %>
      <%= tag.attributes("data-theme": ({ "claro" => "light", "escuro" => "dark", "oled" => "dark" }[tema]),
                         "data-oled": (tema == "oled" ? "" : nil),
                         "data-palette": ComponentesUi::PALETAS.key?(params[:paleta].to_s) && params[:paleta] != ComponentesUi::PALETA_PADRAO ? params[:paleta] : nil,
                         "data-ss-contrast": (params[:contraste] == "alto" ? "high" : nil)) %>>
  <head>
    <title><%= content_for(:title) || "Lista Clara · tela" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= ss_font_tags(self_hosted: true, display: true) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="ss-base ss-inputs">
    <%= yield %>
  </body>
</html>
