<!DOCTYPE html>
<html lang="<%= I18n.locale %>" <%= tag.attributes(ss_density_attrs) %>>
  <head>
    <title><%= content_for(:title) || "Lista Clara · vitrine" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%= ss_display_font_tag(preconnect: false) %>
    <%# Só o tailwind.css (o builds/tailwind/componentes_ui.css é fonte do build, não vai ao navegador). %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# v0.10.1: menu recolhido já no <html> antes da 1ª pintura (sem piscar aberto). %>
    <%= ss_app_shell_head %>
    <%# v0.11: densidade escolhida (localStorage ss-density) antes da 1ª pintura. %>
    <%= ss_density_head %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body>
    <%# A moldura da vitrine é o próprio Ss::AppShellComponent, com o menu gerado das páginas. %>
    <% nav = paginas.group_by { _1[:grupo] }.map do |grupo, ps|
         { title: grupo, items: ps.map { |p| { label: p[:titulo], href: vitrine_path(p[:slug]), current: p[:slug] == pagina_atual } } }
       end %>
    <%= render Ss::AppShellComponent.new(brand: "Lista Clara", nav: nav, search_label: "Buscar componente…", search_action: "vitrine-busca") do |s| %>
      <% s.with_side_footer do %>
        <p style="color:color-mix(in srgb,var(--side-ink) 55%,transparent);font-size:12px;padding:0 6px" class="ss-shell-label">componentes_ui v<%= ComponentesUi::VERSION %> · Rails</p>
      <% end %>
      <% s.with_top do %>
        <%# Idioma dos componentes (?locale=, guardado na sessão pelo ApplicationController). %>
        <nav class="ss-seg vt-idioma" aria-label="Idioma" data-controller="ss-indicator">
          <% { "pt-BR" => "PT", "en" => "EN", "es" => "ES" }.each do |loc, sigla| %>
            <%= link_to sigla, url_for(request.query_parameters.merge(locale: loc)), lang: loc, hreflang: loc, "aria-current": (I18n.locale.to_s == loc ? "true" : nil) %>
          <% end %>
        </nav>
        <%# v0.11: densidade (Compacta/Padrão/Confortável), para comparar as peças. %>
        <%= render Ss::DensityPickerComponent.new(css: "vt-densidade") %>
        <%= render "vitrine/tema" %>
      <% end %>
      <div class="vt-top">
        <h1><%= paginas.find { _1[:slug] == pagina_atual }&.dig(:titulo) %></h1>
      </div>
      <%= yield %>
      <%# Busca de páginas (Ctrl+K): a paleta da gem; a confirmação global serve todo data-turbo-confirm. %>
      <%= render Ss::CommandPaletteComponent.new(id: "vitrine-busca", placeholder: "Buscar componente…",
            groups: paginas.group_by { _1[:grupo] }.map { |grupo, ps| { title: grupo, items: ps.map { |p| { label: p[:titulo], url: vitrine_path(p[:slug]), hint: grupo } } } }) %>
      <%= render Ss::ConfirmDialogComponent.new(id: "vitrine-confirmar") %>
    <% end %>
  </body>
</html>
