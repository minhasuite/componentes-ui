<%# titulo: Tabela de dados | grupo: Dados | ordem: 10 %>
<%
  nomes = ["Mercado Bom Preço", "Padaria Central", "Açougue São Jorge", "Hortifruti da Vila", "Distribuidora Norte", "Café Aroma", "Mercearia Dona Rosa", "Farmácia Vida", "Loja do Zé", "Atacadão Sul", "Bar do Português", "Empório Natural", "Doceria Mel", "Pet Shop Amigo"]
  vendedores = ["Ana Souza", "Bruno Lima", "Carla Mendes"]
  sts = %w[pago aberto vencido pago rascunho aberto pago vencido pago aberto pago pago aberto vencido]
  pedidos = nomes.each_with_index.map { |n, i| { id: 1042 + i, cliente: n, vendedor: vendedores[i % 3], emissao: Date.new(2026, 11, 4) - i * 2, total: (1250.0 * ((i * 37 % 11) + 1) / 3).round(2), status: sts[i], itens: (i % 4) + 2 } }
  mapa = { "pago" => ["Pago", :success], "aberto" => ["Em aberto", :info], "vencido" => ["Vencido", :danger], "rascunho" => ["Rascunho", :neutral] }
  lista = pedidos.select { |p| params[:status].blank? || p[:status] == params[:status] }
                 .select { |p| params[:vendedor].blank? || p[:vendedor] == params[:vendedor] }
                 .select { |p| params[:q].blank? || p[:cliente].downcase.include?(params[:q].to_s.downcase) || p[:id].to_s == params[:q] }
  if (col = params[:sort].presence&.to_sym) && pedidos.first.key?(col)
    lista = lista.sort_by { |p| p[col].is_a?(String) ? p[col].downcase : p[col] }
    lista = lista.reverse if params[:dir] == "desc"
  end
  per = 6
  pages = [(lista.size / per.to_f).ceil, 1].max
  page = params[:page].to_i.clamp(1, pages)
  pagina = lista.slice((page - 1) * per, per) || []
%>
<%= demo "Ss::FilterBarComponent", "Visões salvas em abas, busca, chips dos filtros ativos (× tira) e “+ Filtro”. Tudo por GET: dá para compartilhar o link e voltar.",
      uso: 'render Ss::FilterBarComponent.new(views: [...], filters: [{ param: :status, label: "Situação", options: [["Pago", "pago"], …] }], search: :q)' do %>
  <%= render Ss::FilterBarComponent.new(
        views: [{ label: "Todos", params: {}, count: pedidos.size },
                { label: "Vencidos", params: { status: "vencido" }, count: pedidos.count { _1[:status] == "vencido" } },
                { label: "Em aberto da Ana", params: { status: "aberto", vendedor: "Ana Souza" } }],
        filters: [{ param: :status, label: "Situação", options: mapa.map { |k, (l, _)| [l, k] } },
                  { param: :vendedor, label: "Vendedor", options: vendedores.map { [_1, _1] } }],
        placeholder: "Buscar cliente ou nº") %>
<% end %>

<%= demo "Ss::DataTableComponent", "Ordena pelo cabeçalho (link ?sort=&dir=, aria-sort), esconde colunas (menu, lembrado no navegador), densidade, linha expansível, seleção em massa com a barra flutuante e paginação. No celular, cada linha vira um card.",
      uso: 'render Ss::DataTableComponent.new(rows:, id: "pedidos", caption: "Pedidos", sort: params[:sort], dir: params[:dir], selectable: true, pagination: { page:, pages: }) do |t| t.column … end' do %>
  <%= render Ss::DataTableComponent.new(rows: pagina, id: "pedidos-demo", caption: "Pedidos de novembro", sort: params[:sort], dir: params[:dir],
        selectable: true, bulk_url: vitrine_path("dados_tabela"), pagination: { page: page, pages: pages, total: lista.size }, max_height: "28rem",
        empty: "Nenhum pedido com esses filtros.") do |t| %>
    <% t.column :id, "Nº", sortable: true, hideable: false %>
    <% t.column :cliente, "Cliente", sortable: true, hideable: false %>
    <% t.column :vendedor, "Vendedor", sortable: true %>
    <% t.column :emissao, "Emissão", sortable: true, format: :date %>
    <% t.column :status, "Situação" do |p| %><%= ss_status(p[:status], mapa) %><% end %>
    <% t.column :total, "Total", sortable: true, format: :money %>
    <% t.expansion do |p| %>
      <div style="display:flex;gap:2rem;flex-wrap:wrap;font-size:.85rem">
        <span><b><%= p[:itens] %></b> itens</span><span>Vendedor: <b><%= p[:vendedor] %></b></span><span>Entrega prevista: <b class="num"><%= (p[:emissao] + 5).strftime("%d/%m") %></b></span>
        <a href="#" style="color:var(--accent);font-weight:700">Abrir pedido</a>
      </div>
    <% end %>
    <% t.bulk_actions do %>
      <button type="submit" formmethod="get" formaction="<%= vitrine_path("dados_tabela") %>">Marcar como pago</button>
      <button type="submit" formmethod="get" formaction="<%= vitrine_path("dados_tabela") %>" class="is-danger">Excluir</button>
    <% end %>
  <% end %>
<% end %>

<%= demo "Vazio", "Sem linhas, a tabela mostra o vazio no lugar do corpo (empty:).", uso: 'Ss::DataTableComponent.new(rows: [], empty: "…")' do %>
  <%= render Ss::DataTableComponent.new(rows: [], id: "vazia-demo", caption: "Títulos", tools: false, empty: "Nenhum título vencido. Tudo em dia!") do |t| %>
    <% t.column :cliente, "Cliente" %><% t.column :total, "Total", format: :money %>
  <% end %>
<% end %>
