<%# titulo: Catálogo estático (SVG) | grupo: Catálogo | ordem: 0 %>
<%
  html = File.read(ComponentesUi::Engine.root.join("catalogo/index.html"))
  corpo = html[/<body>(.*)<\/body>/m, 1].to_s
%>
<style>[data-estado] { max-width: 520px; padding: 12px 0; margin-bottom: 18px; }
  section[data-comp] { border-top: 1px solid var(--line); padding-top: 20px; margin-top: 20px; }</style>
<div id="catalogo-v08"><%= raw corpo %></div>
<script>
  document.querySelectorAll("#catalogo-v08 section[data-comp]").forEach((s) => {
    const h = document.createElement("h3"); h.textContent = s.dataset.nome; h.style.cssText = "font-weight:800;font-size:16px"
    const p = document.createElement("p"); p.textContent = s.dataset.descricao; p.style.cssText = "color:var(--muted);font-size:13px;margin-bottom:10px"
    s.prepend(h, p)
    s.querySelectorAll("[data-estado]").forEach((e) => { const t = document.createElement("p"); t.textContent = e.dataset.titulo; t.style.cssText = "font-size:11px;color:var(--muted);margin-bottom:6px;font-family:var(--font-mono)"; e.prepend(t) })
  })
</script>
