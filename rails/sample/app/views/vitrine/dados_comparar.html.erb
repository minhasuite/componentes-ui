<%# titulo: Cotações e comparação | grupo: Dados | ordem: 50 %>
<% barra = ->(c) { %(<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2.5" fill="currentColor" opacity="#{c}"/></svg>).html_safe } %>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:1.5rem;align-items:start">
  <%= demo "Ss::PriceBoardComponent", "Compra/venda com ícone, linha destacada e variação pelo sentido.",
        uso: 'render Ss::PriceBoardComponent.new(caption:, head: %w[Metal Compra Venda], rows: [{ name:, icon:, buy:, sell:, delta:, good:, highlight: }])' do %>
    <%= render Ss::PriceBoardComponent.new(caption: "Cotação dos metais (grama)", head: %w[Metal Compra Venda], rows: [
          { name: "Ouro", icon: barra.(1), buy: "R$ 489,60", sell: "R$ 447,00", delta: "+1,2%", good: true },
          { name: "Prata", icon: barra.(0.6), buy: "R$ 5,60", sell: "R$ 5,20", delta: "−0,4%", good: false, highlight: true },
          { name: "Platina", icon: barra.(0.8), buy: "R$ 304,40", sell: "R$ 277,00", delta: "+0,3%", good: true }]) %>
  <% end %>
  <%= demo "Ss::CompareTableComponent", "Comparação de planos ou fornecedores: coluna recomendada destacada, ✓/— por linha, cabeçalho fixo.",
        uso: 'render Ss::CompareTableComponent.new(caption:, plans: [{ name:, price:, recommended: true }], features: [{ label:, values: [...] }])' do %>
    <%= render Ss::CompareTableComponent.new(caption: "Comparação dos planos",
          plans: [{ name: "Grátis", price: "R$ 0" }, { name: "Pro", price: "R$ 19,90/mês", recommended: true }, { name: "Empresa", price: "R$ 59,90/mês" }],
          features: [{ label: "Lançamentos", values: ["50/mês", "Ilimitados", "Ilimitados"] }, { label: "Usuários", values: ["1", "3", "10"] },
                     { label: "Pergunte à IA", values: [false, true, true] }, { label: "Leitura de fatura", values: [false, true, true] },
                     { label: "Relatórios", values: [true, true, true] }, { label: "Suporte prioritário", values: [false, false, true] }]) %>
  <% end %>
</div>
