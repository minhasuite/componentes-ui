<%# titulo: Controles da casa | grupo: Casa e automação | ordem: 10 %>
<% ic = ->(d) { %(<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">#{d}</svg>).html_safe } %>
<% bulb = ic.('<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/>') %>
<% plug = ic.('<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4"/>') %>
<% fan = ic.('<path d="M12 12c0-3 1-7 4-7s3 4 0 6l-4 1zM12 12c3 0 7 1 7 4s-4 3-6 0l-1-4zM12 12c0 3-1 7-4 7s-3-4 0-6l4-1zM12 12c-3 0-7-1-7-4s4-3 6 0l1 4z"/>') %>
<% gate = ic.('<path d="M3 21V9l9-6 9 6v12M7 21v-8h10v8M7 17h10"/>') %>
<% heat = ic.('<path d="M12 3c1 3 4 4.5 4 8.5a4 4 0 0 1-8 0c0-1.7.8-2.8 1.7-3.7.3 1.4 1 2.2 1.8 2.2C11.5 7.6 10.7 5.4 12 3z"/>') %>
<% tv = ic.('<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8"/>') %>
<% aqui = vitrine_path("casa_controles") %>

<p style="color:var(--muted);max-width:52rem">
  Controles do minha-automacao, iguais aos do app (<code>SsDeviceTile</code>, <code>SsSlider</code>, <code>SsThermostat</code>,
  <code>SsCodeKeypad</code>, <code>SsWeekdayPicker</code>). Aqui os comandos não vão a lugar nenhum: o script da página
  responde depois de 0,7 s (o tile marcado com “falha” e o PIN diferente de 1234 voltam com erro).
  <output id="casa-log" class="ss-badge" style="margin-left:.4rem" aria-live="polite">nenhum envio ainda</output>
</p>

<div data-vt-casa>
<%= demo "Ss::DeviceTileComponent", "Tile de aparelho numa linha (v0.12): o ícone é a chave (role=switch; toque, Enter ou Espaço) e manda o comando, vira na hora e volta se falhar; nome e estado ao lado abrem os detalhes (cobre o tile todo). Ligado tinge na cor do aparelho (tone:) e brilha.",
      uso: 'render Ss::DeviceTileComponent.new(name: "Luz da sala", state: "Ligada · 80%", on: true, icon: svg, url: ponto_path(p), toggle_url: comando_path(p, cmd: "toggle"), tone: :heat, status: :ready)' do %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,11rem),1fr));gap:.9rem;max-width:56rem">
    <%= render Ss::DeviceTileComponent.new(name: "Luz da sala", state: "Desligada", icon: bulb, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Luz da cozinha", state: "Ligada · 80%", on: true, icon: bulb, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Aquecedor do quarto", state: "Ligado · 24 °C", on: true, tone: :heat, icon: heat, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Ventilador", state: "Ligado · média", on: true, tone: :info, icon: fan, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Tomada da TV", state: "Desligada", icon: plug, url: "#", toggle_url: aqui, data: { demo_fail: true }) %>
    <%= render Ss::DeviceTileComponent.new(name: "Portão da garagem", state: "Fechado", status: :locked, icon: gate, url: "#") %>
  </div>
  <p style="height:14px"></p>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr));gap:.9rem;max-width:56rem">
    <%= render Ss::DeviceTileComponent.new(name: "Luz do jardim", state: "Ligada", on: true, status: :unavailable, icon: bulb, url: "#", toggle_url: aqui, wide: true) %>
    <%= render Ss::DeviceTileComponent.new(name: "Televisão", state: "Ligada", on: true, status: :pending, icon: tv, url: "#", toggle_url: aqui, wide: true) %>
    <%= render Ss::DeviceTileComponent.new(name: "Tomada do micro-ondas", state: "Desligada", status: :error, error_text: "Não respondeu (tente de novo)", icon: plug, url: "#", toggle_url: aqui, wide: true) %>
    <%= render Ss::DeviceTileComponent.new(name: "Sensor da porta", state: "Fechada · há 3 min", icon: gate, url: "#", wide: true) %>
  </div>
  <p style="height:14px"></p>
  <div style="max-width:24rem">
