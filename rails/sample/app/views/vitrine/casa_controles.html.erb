<%# titulo: Controles da casa | grupo: Casa e automação | ordem: 10 %>
<% ic = ->(d) { %(<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">#{d}</svg>).html_safe } %>
<% bulb = ic.('<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/>') %>
<% plug = ic.('<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4"/>') %>
<% fan = ic.('<path d="M12 12c0-3 1-7 4-7s3 4 0 6l-4 1zM12 12c3 0 7 1 7 4s-4 3-6 0l-1-4zM12 12c0 3-1 7-4 7s-3-4 0-6l4-1zM12 12c-3 0-7-1-7-4s4-3 6 0l1 4z"/>') %>
<% gate = ic.('<path d="M3 21V9l9-6 9 6v12M7 21v-8h10v8M7 17h10"/>') %>
<% heat = ic.('<path d="M12 3c1 3 4 4.5 4 8.5a4 4 0 0 1-8 0c0-1.7.8-2.8 1.7-3.7.3 1.4 1 2.2 1.8 2.2C11.5 7.6 10.7 5.4 12 3z"/>') %>
<% tv = ic.('<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8"/>') %>
<% aqui = vitrine_path("casa_controles") %>

<p style="color:var(--muted);max-width:52rem">
  Controles do minha-automacao, iguais aos do app (<code>SsDeviceTile</code>, <code>SsSlider</code>, <code>SsThermostat</code>,
  <code>SsCodeKeypad</code>, <code>SsWeekdayPicker</code>). Aqui os comandos não vão a lugar nenhum: o script da página
  responde depois de 0,7 s (o tile marcado com “falha” e o PIN diferente de 1234 voltam com erro).
  <output id="casa-log" class="ss-badge" style="margin-left:.4rem" aria-live="polite">nenhum envio ainda</output>
</p>

<div data-vt-casa>
<%= demo "Ss::DeviceTileComponent", "Tile de aparelho: ícone, nome e estado. O nome abre os detalhes (cobre o tile todo); a chave à direita manda o comando, vira na hora e volta se falhar. Ligado tinge na cor do aparelho (tone:) e brilha.",
      uso: 'render Ss::DeviceTileComponent.new(name: "Luz da sala", state: "Ligada · 80%", on: true, icon: svg, url: ponto_path(p), toggle_url: comando_path(p, cmd: "toggle"), tone: :heat, status: :ready)' do %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,11rem),1fr));gap:.9rem;max-width:56rem">
    <%= render Ss::DeviceTileComponent.new(name: "Luz da sala", state: "Desligada", icon: bulb, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Luz da cozinha", state: "Ligada · 80%", on: true, icon: bulb, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Aquecedor do quarto", state: "Ligado · 24 °C", on: true, tone: :heat, icon: heat, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Ventilador", state: "Ligado · média", on: true, tone: :info, icon: fan, url: "#", toggle_url: aqui) %>
    <%= render Ss::DeviceTileComponent.new(name: "Tomada da TV", state: "Desligada", icon: plug, url: "#", toggle_url: aqui, data: { demo_fail: true }) %>
    <%= render Ss::DeviceTileComponent.new(name: "Portão da garagem", state: "Fechado", status: :locked, icon: gate, url: "#") %>
  </div>
  <p style="height:14px"></p>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr));gap:.9rem;max-width:56rem">
    <%= render Ss::DeviceTileComponent.new(name: "Luz do jardim", state: "Ligada", on: true, status: :unavailable, icon: bulb, url: "#", toggle_url: aqui, wide: true) %>
    <%= render Ss::DeviceTileComponent.new(name: "Televisão", state: "Ligada", on: true, status: :pending, icon: tv, url: "#", toggle_url: aqui, wide: true) %>
    <%= render Ss::DeviceTileComponent.new(name: "Tomada do micro-ondas", state: "Desligada", status: :error, error_text: "Não respondeu (tente de novo)", icon: plug, url: "#", toggle_url: aqui, wide: true) %>
    <%= render Ss::DeviceTileComponent.new(name: "Sensor da porta", state: "Fechada · há 3 min", icon: gate, url: "#", wide: true) %>
  </div>
  <p style="height:14px"></p>
  <div style="max-width:24rem">
    <%= render Ss::DeviceTileComponent.new(name: "Luz da sala de jantar", state: "Ligada · 65%", on: true, tone: :heat, icon: bulb, url: "#", toggle_url: aqui, wide: true) do |t| %>
      <% t.with_footer do %>
        <%= form_with url: aqui, method: :post do %>
          <%= render Ss::RangeComponent.new(name: "value", label: "Brilho", value: 65, format: "%d%%", track: :brightness, tone: :heat, bubble: true, submit: :release, hide_label: true) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= demo "Ss::SwitchComponent", "Chave sozinha. Modo A: checkbox num form (o .ss-switch-row do engine, sem texto se quiser). Modo B: button_to com aria-pressed para comando de aparelho, com o mesmo movimento (líquido, gota, ✓ e halo), aria-busy enquanto envia e volta se falhar. confirm: pergunta antes.",
      uso: 'render Ss::SwitchComponent.new(name: "regra[ativa]", checked: true, label: "Ativa")  ·  render Ss::SwitchComponent.new(url: comando_path(p), on: true, label: "Luz", confirm: "Desligar?")' do %>
  <div class="ss-card ss-card-pad" style="display:flex;flex-wrap:wrap;gap:1.5rem 2.5rem;align-items:center;max-width:56rem">
    <form style="display:contents" onsubmit="return false">
      <%= render Ss::SwitchComponent.new(name: "regra[ativa]", checked: true, label: "Regra ativa", show_label: true, label_end: true) %>
      <%= render Ss::SwitchComponent.new(name: "regra[aviso]", label: "Avisar no celular", show_label: true, label_end: true, confirm: "Ligar os avisos no celular?") %>
      <%= render Ss::SwitchComponent.new(name: "regra[x]", label: "Sem permissão", show_label: true, label_end: true, disabled: true, checked: true) %>
    </form>
    <%= render Ss::SwitchComponent.new(url: aqui, on: true, label: "Luz da varanda", show_label: true) %>
    <%= render Ss::SwitchComponent.new(url: aqui, on: false, label: "Bomba da piscina", show_label: true, confirm: "Ligar a bomba da piscina?") %>
    <%= render Ss::SwitchComponent.new(url: aqui, on: false, label: "Irrigação (falha)", show_label: true, data: { demo_fail: true }) %>
    <%= render Ss::SwitchComponent.new(url: aqui, on: true, label: "Travado", show_label: true, disabled: true) %>
  </div>
<% end %>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:0 2rem">
<%= demo "Ss::RangeComponent (v0.10)", "Trilha em gradiente (track: :brightness, :kelvin, :hue; o seletor pega a cor do ponto), bolha com o valor arrastando (bubble: true) e envio do form ao soltar (submit: :release, com debounce). Sem as opções novas, a marcação é a de antes.",
      uso: 'render Ss::RangeComponent.new(name: "value", label: "Temperatura de cor", value: 2700, min: 2000, max: 6500, step: 100, format: "%d K", track: :kelvin, bubble: true, submit: :release)' do %>
  <div class="ss-card ss-card-pad" style="display:grid;gap:1.4rem">
    <%= form_with url: aqui, method: :post do %>
      <%= render Ss::RangeComponent.new(name: "volume", label: "Volume", value: 40, format: "%d%%", bubble: true, submit: :release) %>
    <% end %>
    <%= form_with url: aqui, method: :post do %>
      <%= render Ss::RangeComponent.new(name: "brilho", label: "Brilho", value: 70, format: "%d%%", track: :brightness, tone: :heat, bubble: true, submit: :release) %>
    <% end %>
    <%= form_with url: aqui, method: :post do %>
      <%= render Ss::RangeComponent.new(name: "kelvin", label: "Temperatura de cor", value: 3000, min: 2000, max: 6500, step: 100, format: "%d K", track: :kelvin, bubble: true, submit: :release) %>
    <% end %>
    <%= form_with url: aqui, method: :post do %>
      <%= render Ss::RangeComponent.new(name: "matiz", label: "Cor", value: 200, max: 360, format: "%d°", track: :hue, bubble: true, submit: :release) %>
    <% end %>
    <%= render Ss::RangeComponent.new(name: "trava", label: "Sem permissão", value: 30, format: "%d%%", disabled: true) %>
  </div>
<% end %>

<%= demo "Ss::RangeComponent variant: :fill", "Barra grossa de tile: a parte cheia é o valor (como o brilho de uma lâmpada), com ícone, rótulo e valor dentro; o texto fica branco só em cima da parte cheia. Teclado e leitor de tela continuam os do input range.",
      uso: 'render Ss::RangeComponent.new(name: "value", label: "Luz da cozinha", value: 65, format: "%d%%", variant: :fill, icon: svg, submit: :release)' do %>
  <div class="ss-card ss-card-pad" style="display:grid;gap:.9rem">
    <%= form_with url: aqui, method: :post do %>
      <%= render Ss::RangeComponent.new(name: "cozinha", label: "Luz da cozinha", value: 65, format: "%d%%", variant: :fill, icon: bulb, submit: :release) %>
    <% end %>
    <%= form_with url: aqui, method: :post do %>
      <%= render Ss::RangeComponent.new(name: "abajur", label: "Abajur", value: 20, format: "%d%%", variant: :fill, track: :brightness, tone: :heat, icon: bulb, submit: :release) %>
    <% end %>
    <%= render Ss::RangeComponent.new(name: "persiana", label: "Persiana (sem permissão)", value: 40, format: "%d%%", variant: :fill, disabled: true) %>
  </div>
<% end %>
</div>

<%= demo "Ss::ThermostatComponent", "Anel de 270° com o alvo, a atual (tracinho) e −/+; arraste a coroa do anel ou use as setas. Envia depois de 0,7 s parado; o modo envia na hora e recolore o anel (aquecer âmbar, resfriar azul, desligado cinza, modo próprio com tone:).",
      uso: 'render Ss::ThermostatComponent.new(name: "value", target: 22.5, current: 20, mode: "heat", url: comando_path(@clima), action: :heating)' do %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr));gap:1rem;max-width:56rem">
    <div class="ss-card ss-card-pad"><%= render Ss::ThermostatComponent.new(name: "value", target: 22.5, current: 20, mode: "heat", url: aqui) %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::ThermostatComponent.new(name: "value", target: 23, current: 26, mode: "cool", url: aqui,
          modes: [:off, :cool, :auto, { value: "dry", label: "Secar", tone: "#14b8a6" }]) %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::ThermostatComponent.new(name: "value", target: 21, current: 21, mode: "auto", url: aqui, action: :idle, pending: true, modes: []) %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::ThermostatComponent.new(name: "value", target: 21, current: 19, mode: "off", url: aqui) %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::ThermostatComponent.new(name: "value", target: 24, current: 23.5, mode: "heat", disabled: true, modes: []) %></div>
  </div>
<% end %>

<%= demo "Ss::CodeKeypadComponent", "PIN do alarme: bolinhas, teclado 3×4 (e o teclado físico: números, Backspace, Enter), apagar. Com length: envia ao completar; senão, o botão ou as ações (Armar ausente/em casa). Errado treme e limpa; enviando trava; certo mostra o ✓. Aqui o PIN certo é 1234.",
      uso: 'render Ss::CodeKeypadComponent.new(url: alarme_path, name: "code", length: 4)  ·  actions: [{ label: "Armar ausente", name: "cmd", value: "arm_away", primary: true }, …]' do %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,18rem),1fr));gap:1rem;max-width:62rem">
    <div class="ss-card ss-card-pad"><%= render Ss::CodeKeypadComponent.new(url: aqui, length: 4, title: "Desarmar (length: 4)") %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::CodeKeypadComponent.new(url: aqui, title: "Armar o alarme",
          actions: [{ label: "Armar ausente", name: "cmd", value: "arm_away", primary: true }, { label: "Armar em casa", name: "cmd", value: "arm_home" }]) %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::CodeKeypadComponent.new(url: aqui, title: "Erro vindo do servidor", error: "Código incorreto (2 tentativas)", obscure: false) %></div>
    <div class="ss-card ss-card-pad"><%= render Ss::CodeKeypadComponent.new(url: aqui, title: "Armando…", length: 4, busy: true) %></div>
  </div>
<% end %>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:0 2rem">
<%= demo "Ss::StepperInputComponent", "Número com −/+ em volta de um input de verdade (digita também). Segurar −/+ repete; nos limites o botão trava.",
      uso: 'render Ss::StepperInputComponent.new(name: "regra[minutos]", label: "Atraso", value: 5, min: 0, max: 60, step: 5, unit: "min")' do %>
  <div class="ss-card ss-card-pad" style="display:grid;gap:1rem">
    <%= render Ss::StepperInputComponent.new(name: "atraso", label: "Atraso", value: 0, min: 0, max: 60, step: 5, unit: "min") %>
    <%= render Ss::StepperInputComponent.new(name: "alvo", label: "Temperatura alvo", value: 30, min: 16, max: 30, step: 0.5, unit: "°C") %>
    <%= render Ss::StepperInputComponent.new(name: "trava", label: "Repetições (sem permissão)", value: 3, min: 1, max: 9, disabled: true) %>
  </div>
<% end %>

<%= demo "Ss::WeekdayPickerComponent", "Sete bolinhas (S T Q Q S S D) que marcam juntas, postadas como name[] (1 = segunda … 7 = domingo); os atalhos trocam tudo e ficam marcados enquanto a escolha bate.",
      uso: 'render Ss::WeekdayPickerComponent.new(name: "regra[dias]", selected: [1, 2, 3, 4, 5])' do %>
  <div class="ss-card ss-card-pad" style="display:grid;gap:1.25rem">
    <%= render Ss::WeekdayPickerComponent.new(name: "dias", selected: [1, 2, 3, 4, 5]) %>
    <%= render Ss::WeekdayPickerComponent.new(name: "dias2", selected: [7, 3], first_day: 7, legend: "Começando no domingo") %>
    <%= render Ss::WeekdayPickerComponent.new(name: "dias3", selected: [6, 7], disabled: true, legend: "Sem permissão") %>
  </div>
<% end %>
</div>
</div>

<script>
  // Simula o servidor: segura o envio dos forms desta página, solta turbo:submit-start e,
  // 0,7 s depois, turbo:submit-end (sucesso, ou falha no que tem data-demo-fail e no PIN ≠ 1234).
  (() => {
    if (window.__casaDemo) return
    window.__casaDemo = true
    document.addEventListener("submit", (e) => {
      const form = e.target
      const box = form.closest("[data-vt-casa]")
      if (!box) return
      e.preventDefault()
      e.stopImmediatePropagation()
      if (form.dataset.turboConfirm && !window.confirm(form.dataset.turboConfirm)) return
      const dados = [...new FormData(form, e.submitter)].filter(([k]) => k !== "authenticity_token").map(([k, v]) => `${k}=${v}`).join(" ")
      const log = document.getElementById("casa-log")
      if (log) log.textContent = `enviado: ${dados || "(comando)"}`
      const keypad = form.matches(".ss-keypad")
      const fail = !!form.closest("[data-demo-fail]") || (keypad && new FormData(form).get("code") !== "1234")
      form.dispatchEvent(new CustomEvent("turbo:submit-start", { bubbles: true, detail: {} }))
      setTimeout(() => {
        form.dispatchEvent(new CustomEvent("turbo:submit-end", { bubbles: true, detail: { success: !fail } }))
        // O teclado com sucesso volta ao começo depois de um tempo (para testar de novo).
        if (keypad && !fail) setTimeout(() => form.dispatchEvent(new Event("ss-code-keypad:reset")), 1600)
      }, 700)
    }, true)
  })()
</script>
