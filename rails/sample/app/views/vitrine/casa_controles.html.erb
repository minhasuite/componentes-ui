<script>
  // Simula o servidor: segura o envio dos forms desta página, solta turbo:submit-start e,
  // 0,7 s depois, turbo:submit-end (sucesso, ou falha no que tem data-demo-fail e no PIN ≠ 1234).
  (() => {
    if (window.__casaDemo) return
    window.__casaDemo = true
    document.addEventListener("submit", (e) => {
      const form = e.target
      const box = form.closest("[data-vt-casa]")
      if (!box) return
      e.preventDefault()
      e.stopImmediatePropagation()
      if (form.dataset.turboConfirm && !window.confirm(form.dataset.turboConfirm)) return
      const dados = [...new FormData(form, e.submitter)].filter(([k]) => k !== "authenticity_token").map(([k, v]) => `${k}=${v}`).join(" ")
      const log = document.getElementById("casa-log")
      if (log) log.textContent = `enviado: ${dados || "(comando)"}`
      const keypad = form.matches(".ss-keypad")
      const fail = !!form.closest("[data-demo-fail]") || (keypad && new FormData(form).get("code") !== "1234")
      form.dispatchEvent(new CustomEvent("turbo:submit-start", { bubbles: true, detail: {} }))
      setTimeout(() => {
        form.dispatchEvent(new CustomEvent("turbo:submit-end", { bubbles: true, detail: { success: !fail } }))
        // O teclado com sucesso volta ao começo depois de um tempo (para testar de novo).
        if (keypad && !fail) setTimeout(() => form.dispatchEvent(new Event("ss-code-keypad:reset")), 1600)
      }, 700)
    }, true)
  })()
</script>

