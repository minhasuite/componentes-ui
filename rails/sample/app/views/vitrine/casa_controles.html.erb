      <% t.with_footer do %>
        <%= form_with url: aqui, method: :post do %>
          <%= render Ss::RangeComponent.new(name: "value", label: "Brilho", value: 65, format: "%d%%", track: :brightness, tone: :heat, bubble: true, submit: :release, hide_label: true) %>
        <% end %>
      <% end %>
    <% end %>
