  <div style="<%= linha %>">
    <button type="button" class="ss-btn ss-btn-outline" onclick="movB.toast('ok')">Toast de sucesso</button>
    <button type="button" class="ss-btn ss-btn-outline" onclick="movB.toast('undo')">Toast com Desfazer</button>
    <button type="button" class="ss-btn ss-btn-outline" onclick="movB.toast('erro')">Toast de erro</button>
  </div>
  <div style="<%= linha %>">
    <button type="button" class="ss-btn ss-btn-outline" data-ss-drawer-open="mov-drawer">Abrir painel lateral</button>
    <button type="button" class="ss-btn ss-btn-outline" onclick="document.getElementById('mov-dialog').showModal()">Abrir diálogo</button>
    <button type="button" class="ss-btn ss-btn-outline" onclick="document.getElementById('mov-sheet').showModal()">Abrir folha</button>
    <%= render Ss::ConfirmDangerComponent.new(name: "Mercado Bom Preço", url: vitrine_path("acabamento_movimento_entrada"), method: :get,
          title: "Excluir o cliente?", text: "Digite o nome; Enter com o nome errado balança o campo.", trigger_label: "Excluir cliente") %>
  </div>
  <div style="<%= linha %>">
    <%= render Ss::PopoverComponent.new(label: "Como calculamos?", title: "Saldo previsto", trigger_class: "ss-btn ss-btn-outline ss-btn-sm") do %>
      <p style="color:var(--ink-2)">Saldo de hoje + o que vence até o fim do mês − o que você já pagou.</p>
    <% end %>
    <%= render Ss::TooltipComponent.new(text: "Exportar CSV") do %><button type="button" class="ss-btn ss-btn-outline ss-btn-sm">Dica (passe o mouse)</button><% end %>
    <%= render Ss::WhatsNewComponent.new(id: "mov-b-#{Time.now.to_i}", items: [
          { id: "a", date: Date.new(2026, 11, 4), title: "Movimento com mola", text: "Gráficos e números entram quando aparecem." },
          { id: "b", date: Date.new(2026, 11, 2), title: "Toast arrastável", text: "Arraste para o lado para dispensar." },
          { id: "c", date: Date.new(2026, 10, 28), title: "Painel lateral", text: "Entra e sai com mola." }]) %>
    <%= render Ss::TourComponent.new(id: "mov-b", autostart: false, start_label: "Ver tour (o foco pula com mola)", steps: [
          { target: "mov-t1", title: "Toasts", text: "Arraste para o lado para dispensar." },
          { target: "mov-t2", title: "Gráficos", text: "Entram quando aparecem na tela." },
          { target: "mov-t3", title: "Cards", text: "Sobem em cascata." }]) %>
  </div>
  <div class="ss-toasts is-inline" data-tour-step="mov-t1" style="gap:.6rem">
    <%= render Ss::ToastComponent.new(message: "Arraste este para o lado →", sticky: true) %>
  </div>
  <template id="mov-toast-ok"><%= render Ss::ToastComponent.new(message: "Alterações salvas", tone: :good) %></template>
  <template id="mov-toast-undo"><%= render Ss::ToastComponent.new(message: "Pedido 1042 excluído", undo_url: "#", undo_method: :get) %></template>
  <template id="mov-toast-erro"><%= render Ss::ToastComponent.new(message: "Sem conexão. Tente de novo.", tone: :bad) %></template>
<% end %>
<%= render Ss::ToastStackComponent.new %>
<%= render Ss::DrawerComponent.new(id: "mov-drawer", title: "Pedido 1042") do |d| %>
  <p style="color:var(--ink-2)">Entrou deslizando com mola. Feche no X, no Esc ou no fundo: ele sai deslizando antes de fechar.</p>
  <% d.with_footer do %><button type="button" class="ss-btn ss-btn-primary" data-action="ss-drawer#close">Concluir</button><% end %>
<% end %>
<dialog class="ss-dialog" id="mov-dialog" aria-labelledby="mov-dialog-t">
