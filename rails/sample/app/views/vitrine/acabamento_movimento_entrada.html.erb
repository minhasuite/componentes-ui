  <div data-tour-step="mov-t3">
    <%= render Ss::BentoGridComponent.new do |g| %>
      <% g.with_block(cols: 2, rows: 2, tone: :grad) do %><p class="ss-kicker">Destaque</p><h3 style="font-size:1.4rem;margin-top:.4rem">Vendas subiram 12%</h3><% end %>
      <% g.with_block(tone: :soft) do %><h3>Clientes</h3><p>48 novos</p><% end %>
      <% g.with_block do %><h3>Estoque</h3><p>3 itens acabando</p><% end %>
      <% g.with_block(cols: 2) do %><h3>Agenda</h3><p>5 entregas hoje</p><% end %>
