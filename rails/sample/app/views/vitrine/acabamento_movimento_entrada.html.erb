<%# titulo: Movimento: entrada, números e camadas | grupo: Acabamento | ordem: 21 %>
<%# Playground do movimento (lote B): role a página devagar — cada bloco anima quando ~25% dele aparece.
    "Repetir" toca a entrada de novo (evento ss:replay). Com menos movimento no sistema, nada anima. %>
<% repetir = ->(rotulo = "Repetir") { tag.button(rotulo, type: "button", class: "ss-btn ss-btn-ghost ss-btn-sm", onclick: "this.closest('.vt-demo').dispatchEvent(new CustomEvent('ss:replay'))") } %>
<% linha = "display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-bottom:1rem" %>
<% grade = ->(min) { "display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,#{min}),1fr));gap:1rem" } %>
<% vao = ->(texto = "role para baixo ↓") { tag.div(texto, style: "height:55vh;display:grid;place-items:center;color:var(--muted);font-size:.85rem") } %>

<p style="color:var(--ink-2);max-width:44rem">A mesma mola do menu do app (<code>--ss-bounce</code>: passa ~12% e assenta) nas entradas, nos números e nas camadas.
  Gráficos, números e cards só animam quando aparecem (controller <code>ss-in-view</code>); sem JS ou com menos movimento, o conteúdo já aparece pronto.</p>

<%= demo "Ss::KpiStripComponent", "O número conta (Ss::CountUpComponent por dentro), a variação pula e o minigráfico se desenha em cascata.",
      uso: 'render Ss::KpiStripComponent.new(items: [{ label: "Vendido", value: "R$ 48.320,00", money: true, delta: "+12%", good: true, spark: [...] }])  ·  count: false para não contar' do %>
  <div style="<%= linha %>"><%= repetir.call %></div>
  <%= render Ss::KpiStripComponent.new(items: [
        { label: "Vendido", value: "R$ 48.320,00", money: true, delta: "+12%", good: true, hint: "vs. out", spark: [3, 5, 4, 8, 7, 9, 12] },
        { label: "Pedidos", value: "214", delta: "−3%", good: false, spark: [9, 8, 8, 7, 9, 6, 7] },
        { label: "Ticket médio", value: "R$ 225,79", money: true, delta: "+4%", good: true, spark: [4, 4, 5, 5, 6, 6, 7] },
        { label: "Meta batida", value: "92,4%", spark: [2, 4, 5, 7, 8, 9, 9] }]) %>
<% end %>

<%= demo "Troca de número: conta ou rola", "Mude o valor: sem roll, conta do antigo ao novo; com roll: true, os dígitos que mudaram rolam (sobem se aumentou, descem se caiu) e assentam com mola.",
      uso: 'render Ss::CountUpComponent.new(value: 1250.4, format: :money, roll: true)  ·  el.dataset.ssCountUpValueValue = 1310 (ou morph do Turbo)' do %>
  <div style="<%= grade.call("15rem") %>">
    <div class="ss-card ss-card-pad">
      <p class="ss-kicker">Saldo (roll)</p>
      <div style="font-size:2.2rem;margin:.4rem 0 .9rem"><%= render Ss::CountUpComponent.new(value: 1250.4, format: :money, roll: true, id: "mov-saldo") %></div>
      <div style="display:flex;gap:.5rem">
        <button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.soma('mov-saldo', 87.35)">+ R$ 87,35</button>
        <button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.soma('mov-saldo', -142.1)">− R$ 142,10</button>
      </div>
    </div>
    <div class="ss-card ss-card-pad">
      <p class="ss-kicker">Pedidos hoje (roll)</p>
      <div style="font-size:2.2rem;margin:.4rem 0 .9rem"><%= render Ss::CountUpComponent.new(value: 98, roll: true, id: "mov-pedidos") %></div>
      <div style="display:flex;gap:.5rem">
        <button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.soma('mov-pedidos', 1)">+1</button>
        <button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.soma('mov-pedidos', 3)">+3</button>
        <button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.soma('mov-pedidos', -5)">−5</button>
      </div>
    </div>
    <div class="ss-card ss-card-pad">
      <p class="ss-kicker">Meta (conta)</p>
      <div style="font-size:2.2rem;margin:.4rem 0 .9rem"><%= render Ss::CountUpComponent.new(value: 64.5, format: :percent, decimals: 1, id: "mov-meta") %></div>
      <div style="display:flex;gap:.5rem">
        <button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.define('mov-meta', Math.round(Math.random() * 1000) / 10)">Sortear</button>
      </div>
    </div>
  </div>
<% end %>

<%= demo "Ss::PriceBoardComponent", "Preço que muda (morph do Turbo, stream ou JS) rola no lugar: o controller ss-count-up vigia as células td.num.",
      uso: 'render Ss::PriceBoardComponent.new(caption: "Metais", rows: [...])  ·  o texto da célula mudou → rola' do %>
  <div style="<%= linha %>"><button type="button" class="ss-btn ss-btn-outline ss-btn-sm" onclick="movB.cotacoes()">Atualizar cotações</button></div>
  <%= render Ss::PriceBoardComponent.new(caption: "Metais", head: %w[Metal Compra Venda], id: "mov-precos", rows: [
        { name: "Ouro", buy: "R$ 348,96", sell: "R$ 344,70", delta: "+1,2%", good: true, highlight: true },
        { name: "Prata", buy: "R$ 4,12", sell: "R$ 3,98", delta: "−0,4%", good: false },
        { name: "Platina", buy: "R$ 172,30", sell: "R$ 169,85", delta: "+0,1%", good: true }]) %>
<% end %>

<%= vao.call %>

<%= demo "Ss::AreaChartComponent · Ss::DonutChartComponent", "A linha se desenha, a área sobe atrás dela e o ponto pula com mola. Na rosca, as fatias varrem em cascata e a legenda pula.",
      uso: 'render Ss::AreaChartComponent.new(title:, points:)  ·  render Ss::DonutChartComponent.new(title:, slices:, exploded: true)' do %>
  <div style="<%= linha %>"><%= repetir.call %></div>
  <div style="<%= grade.call("18rem") %>;align-items:center">
    <div class="ss-card ss-card-pad">
      <%= render Ss::AreaChartComponent.new(title: "Gastos por mês", show_title: true, active: 4,
            points: [["jun", 3120], ["jul", 2980], ["ago", 3410], ["set", 2870], ["out", 3960], ["nov", 3580]], format: ->(v) { "R$ #{v.round}" }) %>
    </div>
    <div class="ss-card ss-card-pad">
      <%= render Ss::DonutChartComponent.new(title: "Para onde foi", center: "R$ 980", center_label: "novembro", exploded: true,
            slices: [{ label: "Mercado", value: 420 }, { label: "Casa", value: 260 }, { label: "Lazer", value: 160 }, { label: "Saúde", value: 90 }, { label: "Outros", value: 50 }]) %>
    </div>
  </div>
<% end %>

<%= demo "Medidor, anéis, barras e minigráfico (helpers)", "ss_gauge, ss_rings, .ss-bars e ss_sparkline ganham o ss-in-view sozinhos: a agulha gira com mola, os anéis enchem em cascata e as barras sobem uma a uma.",
      uso: 'ss_gauge(0.72, label: "da meta")  ·  ss_rings([0.8, 0.55, 0.3])  ·  <div class="ss-bars">…  ·  ss_sparkline([...])' do %>
  <div style="<%= linha %>"><%= repetir.call %></div>
  <div style="<%= grade.call("13rem") %>;align-items:end">
    <div class="ss-card ss-card-pad" style="display:grid;justify-items:center"><%= ss_gauge(0.72, label: "da meta") %></div>
    <div class="ss-card ss-card-pad" style="display:grid;justify-items:center"><%= ss_rings([0.82, 0.56, 0.34], center: "82%") %></div>
    <div class="ss-card ss-card-pad">
      <div class="ss-bars">
        <% [[0.35, "seg"], [0.6, "ter"], [0.45, "qua"], [0.9, "qui"], [0.7, "sex"], [0.5, "sáb"], [0.25, "dom"]].each_with_index do |(v, d), i| %>
          <div class="ss-bar<%= " is-today" if i == 3 %>" style="--v:<%= v %>"><b><%= (v * 15).round(1).to_s.tr(".", ",") %> mil</b><i></i><span><%= d %></span></div>
        <% end %>
      </div>
    </div>
    <div class="ss-stat"><div class="ss-stat-body"><p class="ss-stat-label">Recebido</p><%= ss_amount("R$ 12.480,00") %></div><%= ss_sparkline([4, 6, 5, 8, 7, 10, 12, 11, 14]) %></div>
  </div>
<% end %>

