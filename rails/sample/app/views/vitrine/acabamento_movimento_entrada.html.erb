          steps: ["Ler arquivo", "Validar", "Gravar"], current_step: 1, detail: "1.264 de 3.010 linhas") %>
    <%= render Ss::LevelCardComponent.new(points: 4860, level: 3, next_at: 6000, next_label: "nível 4") %>
  </div>
<% end %>

<%= vao.call("camadas ↓") %>

<%= demo "Camadas com mola", "Toast entra com mola e sai arrastando para o lado (passou do limite, voa; senão volta); a pilha desliza quando um sai. Painel lateral, diálogo e folha entram com mola e saem animando.",
