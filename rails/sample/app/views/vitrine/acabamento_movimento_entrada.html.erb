        <% c.with_image { render("vitrine/planta_b", variante: i) } %>
      <% end %>
    <% end %>
  </div>
  <div style="<%= grade.call("16rem") %>;margin-top:1.5rem">
    <%= render Ss::ReviewCardComponent.new(name: "Carla Mendes", role: "Padaria Central", rating: 4.5, text: "Fecho o caixa em cinco minutos.") %>
    <%= render Ss::ReviewCardComponent.new(name: "Rui Prado", role: "Mercado Bom Preço", rating: 5, text: "O app de vendas externas mudou a rota.") %>
    <%= render Ss::PersonCardComponent.new(name: "Ana Souza", role: "Vendedora · Zona Sul", status: "ok", metrics: [["Vendido", "R$ 48 mil"], ["Pedidos", "214"]], team: %w[Bruno Caio Duda]) %>
  </div>
<% end %>

