<script>
  // Botões do playground (sem controller próprio: só mexem nos valores/DOM, os componentes animam sozinhos).
  window.movB = {
    soma(id, d) { const el = document.getElementById(id); this.define(id, Math.round((parseFloat(el.dataset.ssCountUpValueValue) + d) * 100) / 100) },
    define(id, v) { document.getElementById(id).dataset.ssCountUpValueValue = v },
    cotacoes() {
      document.querySelectorAll("#mov-precos td.num").forEach((td) => {
        const n = parseFloat(td.textContent.replace(/[^\d,]/g, "").replace(",", "."))
        const novo = Math.max(0.5, n * (1 + (Math.random() - 0.45) * 0.08))
        td.textContent = "R$ " + novo.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      })
    },
    job() {
      const job = document.getElementById("mov-job")
      const bar = job.querySelector(".ss-job-bar i")
      const pct = Math.min(100, parseFloat(bar.style.width) + 19)
      bar.style.width = pct + "%"
      job.querySelector("[role=progressbar]").setAttribute("aria-valuenow", Math.round(pct))
      const n = job.querySelector(".ss-status .num"); if (n) n.textContent = Math.round(pct) + "%"
      if (pct >= 100) setTimeout(() => { bar.style.width = "0%"; requestAnimationFrame(() => (bar.style.width = "42%")) }, 900)
    },
    toast(tipo) { document.getElementById("ss-toasts").append(document.getElementById("mov-toast-" + tipo).content.cloneNode(true)) }
  }
</script>
